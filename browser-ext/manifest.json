{
    "name": "LinkedIn to API Exporter",
    "description": "Export a LinkedIn profile page to an API",
    "manifest_version": 3,
    "key": "",
    "icons": {
        "36": "icon-36.png",
        "46": "icon-46.png",
        "80": "icon-80.png",
        "100": "icon-100.png",
        "260": "icon-260.png"
    },
    "action": {
        "default_popup": "./popup.html"
    },
    "background": {
        "service_worker": "./background.js",
        "type": "module"
    },
    "permissions": ["declarativeContent", "activeTab", "storage", "scripting", "identity"],
    "optional_permissions": [],
    "host_permissions": ["https://www.linkedin.com/", "https://ha-dev-core-service.azurewebsites.net/*", "https://ha-prod-core-service.azurewebsites.net/*", "https://login.microsoftonline.com/*"],
    "optional_host_permissions": ["*://*/*"]
}
